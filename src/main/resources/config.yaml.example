ibkr:
  host: "127.0.0.1"
  port: 7497
  accountId: "DUN123"
  syncTimeout: 30
  autoExecute: false
  postOnly: true
  tickers: ["SPY", "AAPL", "MSFT", "AMZN", "NVDA", "TSLA", "META", "AMD", "PLTR", "LLY", "ABNB", "COST", "MARA", "RIOT",
            "BITX", "MSTR", "MU", "URA", "TSM", "OKLO", "COIN", "GOOGL", "GOOG", "BABA", "ALB", "AMDL", "NFLX", "IWM",
            "NVO", "PEP", "INTC", "GM", "MDB", "CVX", "KDP", "CCL", "LOW", "DECK", "DIA", "TNA", "XPEV", "MO", "ACN",
            "WMT", "DELL", "AES", "KO", "BYND", "SMCI", "AVGO", "ARM", "QCOM", "CRWD", "SHOP", "XYZ", "DDOG", "CVNA",
            "UPST", "HOOD", "AFRM", "RIVN", "NIO", "PDD", "JD", "SOXL", "TQQQ", "ARKK"]

risk:
  riskPerTradePct: 0.02   # 2% max risk per trade
  maxConcurrentTrades: 4

ai:
  geminiApiKey: "key"
  enabled: true
  endpointBase: "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key="

telegram:
  botToken: "token"
  chatId: "chatId"
  masterKey: "masterKey"

strategies:
  global:
    tpAtrMultiplier: 1.2
    slAtrMultiplier: 0.8
  opening:
    bandWidth: 1.2
    callMinGap: -1.5
    callMaxGap: -4.0
    putMinGap: 1.5
    putMaxGap: 4.0
  continuation:
    callMinGap: 0.4
    callMaxGap: 1.8
    callWordenThreshold: 55.0
    putMinGap: -0.4
    putMaxGap: -1.8
    putWordenThreshold: 45.0