# Dockerfile for Python Analytics Service
# Build: docker build -f python/Dockerfile.analytics -t optionsquant-python-analytics .

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy analytics service code
COPY analytics_service/ ./analytics_service/

# Expose port
EXPOSE 8001

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Run the service
CMD ["python", "-m", "uvicorn", "analytics_service.main:app", "--host", "0.0.0.0", "--port", "8001"]